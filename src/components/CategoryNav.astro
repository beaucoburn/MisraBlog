---
import { sanityClient } from '../lib/sanity';
import { CATEGORIES_QUERY } from '../lib/queries';
import type { Locale } from '../lib/i18n';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const categories = await sanityClient.fetch(CATEGORIES_QUERY, { lang });
---
<nav aria-label="Categories">
	<ul>
		{categories.map((c: { _id: string; title: string; slug: string }) => (
			<li><a href={`/${lang}/category/${c.slug}`}>{c.title}</a></li>
		))}
	</ul>
</nav>

<style>
	/* Layout only (the visual design pass is still to come): a wrapping
	   row so a long category list reflows instead of overflowing a narrow
	   screen. Scoped here rather than in SiteHeader because Astro's scoped
	   styles don't reach into a child component's markup. */
	ul {
		display: flex;
		flex-wrap: wrap;
		gap: 0.25rem 1rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	a {
		display: inline-block;
		padding: 0.25rem 0;
	}
</style>
