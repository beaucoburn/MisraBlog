---
import { sanityClient } from '../lib/sanity';
import { CATEGORIES_QUERY } from '../lib/queries';

// TODO(i18n): hardcoded to "en" until Astro's i18n routing is wired up to
// pass through the active locale (separate follow-up phase).
const categories = await sanityClient.fetch(CATEGORIES_QUERY, { lang: 'en' });
---
<nav aria-label="Categories">
	<ul>
		{categories.map((c: { _id: string; title: string; slug: string }) => (
			<li><a href={`/category/${c.slug}`}>{c.title}</a></li>
		))}
	</ul>
</nav>
