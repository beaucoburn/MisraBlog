---
// The one header for every page, so navigation doesn't differ between the
// homepage, a category listing and a post.
//
// Layout: the logo sits centered on its own row, with a single centered
// nav bar beneath it (categories, then About, then the language switcher).
// The logo is the full cartouche logo, src/assets/logo/logo-full.* (see
// lib/siteImages.ts), falling back to the site name as text if it's absent.
//
// `switcherLinks` is a prop rather than something computed here because
// only the page knows how to reach itself in the other locale:
//   - home / about / category pages: the path is identical apart from the
//     locale segment, so `localizedPaths()` is enough.
//   - post pages: slugs differ per language, so the sibling has to be
//     resolved through translation.metadata first.
import { Image } from 'astro:assets';
import CategoryNav from './CategoryNav.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';
import { logoImage } from '../lib/siteImages';
import {
  ABOUT_LABEL,
  HOME_LINK_LABEL,
  PAGES_NAV_LABEL,
  SITE_TITLE,
  type Locale,
} from '../lib/i18n';

interface Props {
  lang: Locale;
  switcherLinks: Partial<Record<Locale, string>>;
}

const { lang, switcherLinks } = Astro.props;
---
<header class="site-header">
	<a class="site-header__logo" href={`/${lang}/`} aria-label={`${SITE_TITLE} — ${HOME_LINK_LABEL[lang]}`}>
		{logoImage ? (
			<Image
				src={logoImage}
				alt=""
				height={160}
				loading="eager"
				format={logoImage.format === 'svg' ? 'svg' : undefined}
			/>
		) : (
			<span class="site-header__wordmark">{SITE_TITLE}</span>
		)}
	</a>
	<div class="site-header__bar">
		<CategoryNav lang={lang} />
		<nav aria-label={PAGES_NAV_LABEL[lang]}>
			<ul>
				<li><a href={`/${lang}/about`}>{ABOUT_LABEL[lang]}</a></li>
			</ul>
		</nav>
		<LanguageSwitcher currentLang={lang} links={switcherLinks} />
	</div>
</header>

<style>
	.site-header {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 1rem;
		text-align: center;
	}

	.site-header__logo {
		display: inline-block;
		color: inherit;
		text-decoration: none;
	}

	.site-header__logo img {
		display: block;
		width: auto;
		/* The cartouche (~1.75:1) carries fine lettering and a garland, so it
		   gets room: ~160px tall (~280px wide) on desktop, ~110px on a phone. */
		max-height: clamp(6rem, 30vw, 10rem);
	}

	.site-header__wordmark {
		font-size: clamp(1.75rem, 7vw, 2.75rem);
		font-weight: 700;
		line-height: 1.1;
	}

	.site-header__logo:hover .site-header__wordmark,
	.site-header__logo:focus-visible .site-header__wordmark {
		text-decoration: underline;
	}

	/* One centered bar; wrapping flex rather than a hamburger menu, so no
	   JS, and on a ~375px screen it reflows into centered rows instead of
	   overflowing. The divider lines frame it as a "bar" without needing a
	   background color the pastel pass will want to own. */
	.site-header__bar {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		align-items: baseline;
		gap: 0.25rem 1.5rem;
		width: 100%;
		padding: 0.5rem 0;
		border-block: 1px solid var(--color-rule);
	}

	nav ul {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 0.25rem 1rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	nav a {
		/* Roomier hit target for touch, without changing layout much. */
		display: inline-block;
		padding: 0.25rem 0;
	}
</style>
