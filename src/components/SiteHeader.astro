---
// The one header for every page, so navigation doesn't differ between the
// homepage, a category listing and a post.
//
// Layout: the logo sits centered on its own row, with a single nav bar
// beneath it: categories left-aligned, the language switcher pushed to the
// right end. (About lives in the footer.)
// The logo is the full cartouche logo, src/assets/logo/logo-full.* (see
// lib/siteImages.ts), falling back to the site name as text if it's absent.
//
// `switcherLinks` is a prop rather than something computed here because
// only the page knows how to reach itself in the other locale:
//   - home / about / category pages: the path is identical apart from the
//     locale segment, so `localizedPaths()` is enough.
//   - post pages: slugs differ per language, so the sibling has to be
//     resolved through translation.metadata first.
import { Image } from 'astro:assets';
import CategoryNav from './CategoryNav.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';
import { logoImage } from '../lib/siteImages';
import {
  HOME_LINK_LABEL,
  SITE_TITLE,
  type Locale,
} from '../lib/i18n';

interface Props {
  lang: Locale;
  switcherLinks: Partial<Record<Locale, string>>;
}

const { lang, switcherLinks } = Astro.props;
---
<header class="site-header">
	<a class="site-header__logo" href={`/${lang}/`} aria-label={`${SITE_TITLE} — ${HOME_LINK_LABEL[lang]}`}>
		{logoImage ? (
			<Image
				src={logoImage}
				alt=""
				height={160}
				loading="eager"
				format={logoImage.format === 'svg' ? 'svg' : undefined}
			/>
		) : (
			<span class="site-header__wordmark">{SITE_TITLE}</span>
		)}
	</a>
	<div class="site-header__bar" data-bloom-keepout="full-width">
		<CategoryNav lang={lang} />
		<div class="site-header__switcher">
			<LanguageSwitcher currentLang={lang} links={switcherLinks} />
		</div>
	</div>
</header>

<style>
	.site-header {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 1rem;
		text-align: center;
	}

	.site-header__logo {
		display: inline-block;
		color: inherit;
		text-decoration: none;
	}

	.site-header__logo img {
		display: block;
		width: auto;
		/* The cartouche (~1.75:1) carries fine lettering and a garland, so it
		   gets room: ~160px tall (~280px wide) on desktop, ~110px on a phone. */
		max-height: clamp(6rem, 30vw, 10rem);
	}

	.site-header__wordmark {
		font-size: clamp(1.75rem, 7vw, 2.75rem);
		font-weight: 700;
		line-height: 1.1;
	}

	.site-header__logo:hover .site-header__wordmark,
	.site-header__logo:focus-visible .site-header__wordmark {
		text-decoration: underline;
	}

	/* One left-aligned bar; wrapping flex rather than a hamburger menu, so
	   no JS, and on a ~375px screen it reflows into rows instead of
	   overflowing.

	   The rose band runs the full width of the screen while the links stay
	   aligned with the site's content width: the element itself keeps its
	   in-box width, and a huge box-shadow in the same color, clipped to the
	   bar's own height, paints the background out to both screen edges.
	   Unlike a 100vw element this never causes horizontal scrolling. The
	   negative bottom margin sits the bar flush on the header box's bottom
	   edge instead of floating above the box's padding.

	   The painted band is wider than this element's getBoundingClientRect(),
	   so it's marked data-bloom-keepout="full-width": the bloom trail keeps
	   daisies off its whole row, edge to edge. */
	.site-header__bar {
		display: flex;
		flex-wrap: wrap;
		justify-content: flex-start;
		align-items: baseline;
		gap: 0.25rem 1.5rem;
		width: 100%;
		margin-bottom: calc(-1 * var(--content-box-padding));
		padding: 0.5rem 0;
		background: var(--color-nav);
		box-shadow: 0 0 0 100vmax var(--color-nav);
		clip-path: inset(0 -100vmax);
		color: var(--color-nav-text);
		text-align: start;
	}

	/* :global because the category and language links are rendered by child
	   components, which this file's scoped styles can't otherwise reach. */
	.site-header__bar :global(a) {
		color: var(--color-nav-text);
		text-decoration: none;
	}

	.site-header__bar :global(a:hover) {
		text-decoration: underline;
	}

	/* The site-wide focus ring is the dark rose link color, which would
	   vanish on the rose bar. */
	.site-header__bar :global(a:focus-visible) {
		outline-color: var(--color-nav-text);
		text-decoration: underline;
	}

	/* Auto margin pushes the switcher to the right end, including when it
	   wraps onto its own row on a narrow screen. */
	.site-header__switcher {
		margin-inline-start: auto;
	}

</style>
