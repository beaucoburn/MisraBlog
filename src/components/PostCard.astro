---
// One card, used by both the homepage feed and the category listing, so
// the two can't drift apart visually or structurally.
//
// Everything except the title and slug is optional and is omitted rather
// than faked when missing: no placeholder box when a post has no
// coverImage, no summary line when it has no excerpt yet (both fields were
// added to the schema after content already existed).
//
// `headingLevel` exists so the card slots under whatever heading the host
// page already has without skipping a level — h3 under the homepage's
// "Latest posts" h2, h2 directly under a category page's h1.
import { formatDate, type Locale } from '../lib/i18n';
import type { PostSummary } from '../lib/content';

interface Props {
  lang: Locale;
  post: PostSummary;
  headingLevel?: 2 | 3;
  // `row` (default): thumbnail beside the text, for list views like the
  // category listing. `tile`: thumbnail stacked on top at a fixed aspect
  // ratio, so cards line up when placed in a grid (the homepage).
  variant?: 'row' | 'tile';
}

const { lang, post, headingLevel = 2, variant = 'row' } = Astro.props;

const Heading = `h${headingLevel}` as 'h2' | 'h3';
const href = `/${lang}/post/${post.slug}`;
const coverUrl = post.coverImage?.asset?.url;
const categories = post.categories ?? [];
---
<article class:list={['post-card', `post-card--${variant}`]}>
	{coverUrl && (
		<a class="post-card__thumb" href={href}>
			<img src={coverUrl} alt={post.coverImage?.alt || post.title} loading="lazy" />
		</a>
	)}
	<div class="post-card__text">
		<Heading class="post-card__title"><a href={href}>{post.title}</a></Heading>
		{post.publishedAt && (
			<p class="post-card__date">
				<time datetime={post.publishedAt}>{formatDate(post.publishedAt, lang)}</time>
			</p>
		)}
		{post.excerpt && <p class="post-card__excerpt">{post.excerpt}</p>}
		{categories.length > 0 && (
			<ul class="post-card__categories">
				{categories.map((category) => (
					<li>
						<a class="post-card__chip" href={`/${lang}/category/${category.slug}`}>{category.title}</a>
					</li>
				))}
			</ul>
		)}
	</div>
</article>

<style>
	.post-card {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem 1rem;
		padding: 1rem 0;
		border-top: 1px solid var(--color-rule);
	}

	/* Thumbnail sits beside the text when there's room and stacks above it
	   on a phone; `min(100%, 12rem)` keeps it from ever forcing overflow. */
	.post-card__thumb {
		flex: 0 0 auto;
		width: min(100%, 12rem);
	}

	.post-card__thumb img {
		display: block;
		width: 100%;
		height: auto;
		border-radius: 4px;
	}

	.post-card__text {
		flex: 1 1 16rem;
		min-width: 0;
	}

	.post-card__title {
		margin: 0 0 0.25rem;
		font-size: clamp(1.125rem, 3vw, 1.375rem);
		line-height: 1.3;
	}

	.post-card__date {
		margin: 0 0 0.5rem;
		font-size: 0.875rem;
		color: var(--color-muted);
	}

	.post-card__excerpt {
		margin: 0 0 0.75rem;
		overflow-wrap: break-word;
	}

	.post-card__categories {
		display: flex;
		flex-wrap: wrap;
		gap: 0.375rem 0.5rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.post-card__chip {
		display: inline-block;
		padding: 0.2rem 0.6rem;
		border: 1px solid var(--color-chip-line);
		border-radius: 999px;
		background: var(--color-chip);
		font-size: 0.8125rem;
		text-decoration: none;
	}

	/* Tile: everything stacked, the thumbnail full-width and cropped to a
	   consistent shape. No top rule — the grid gap separates tiles. */
	.post-card--tile {
		flex-direction: column;
		flex-wrap: nowrap;
		height: 100%;
		padding: 0;
		border-top: none;
	}

	.post-card--tile .post-card__thumb {
		width: 100%;
	}

	.post-card--tile .post-card__thumb img {
		aspect-ratio: 3 / 2;
		object-fit: cover;
	}

	.post-card--tile .post-card__text {
		flex: 1 1 auto;
	}

	.post-card__chip:hover,
	.post-card__chip:focus-visible {
		text-decoration: underline;
	}
</style>
