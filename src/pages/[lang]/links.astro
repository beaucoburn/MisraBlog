---
// Link-in-bio page: what her Instagram bio links to. Visitors arriving
// from Instagram are almost always on a phone and usually after a post
// they just saw, so the page leads with the latest posts as big tappable
// cards, then a couple of plain buttons. It updates itself on every
// publish (same rebuild as the rest of the site), so there's nothing to
// maintain and no third-party link service to hand over.
//
// Same header and footer as every other page, so a visitor can keep
// browsing; not linked from the nav, since it's an entry point, not a
// section of the site.
import Layout from '../../layouts/Layout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import PostCard from '../../components/PostCard.astro';
import { sanityClient } from '../../lib/sanity';
import { LATEST_POSTS_QUERY } from '../../lib/queries';
import {
	ABOUT_LABEL,
	ALL_POSTS_LABEL,
	INSTAGRAM_HANDLE,
	INSTAGRAM_URL,
	LINKS_PAGE_TITLE,
	LINKS_WELCOME,
	LOCALES,
	NO_POSTS_MESSAGE,
	localizedPaths,
	type Locale,
} from '../../lib/i18n';
import type { PostSummary } from '../../lib/content';

// Enough to cover what she's posted about recently without becoming a
// second homepage.
const LINKS_POSTS_LIMIT = 5;

export function getStaticPaths() {
	return LOCALES.map((lang) => ({
		params: { lang },
		props: { lang },
	}));
}

interface Props {
	lang: Locale;
}

const { lang } = Astro.props;

const posts: PostSummary[] = await sanityClient.fetch(LATEST_POSTS_QUERY, {
	lang,
	limit: LINKS_POSTS_LIMIT,
});
---
<Layout lang={lang} pageTitle={LINKS_PAGE_TITLE[lang]}>
	<SiteHeader lang={lang} switcherLinks={localizedPaths('links')} slot="nav" />
	<h1>{LINKS_WELCOME[lang]}</h1>
	{posts.length > 0 ? (
		<ul class="links-posts">
			{posts.map((post) => (
				<li><PostCard lang={lang} post={post} headingLevel={2} /></li>
			))}
		</ul>
	) : (
		<p class="empty">{NO_POSTS_MESSAGE[lang]}</p>
	)}
	<ul class="links-buttons">
		<li><a class="links-button" href={`/${lang}/`}>{ALL_POSTS_LABEL[lang]}</a></li>
		<li><a class="links-button links-button--quiet" href={`/${lang}/about`}>{ABOUT_LABEL[lang]}</a></li>
		<li>
			<a class="links-button links-button--quiet" href={INSTAGRAM_URL} rel="me">
				Instagram · @{INSTAGRAM_HANDLE}
			</a>
		</li>
	</ul>
</Layout>

<style>
	h1 {
		margin: 0 0 1.25rem;
		font-size: clamp(1.25rem, 4.5vw, 1.6rem);
		line-height: 1.3;
		text-align: center;
	}

	.links-posts,
	.links-buttons {
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.empty {
		text-align: center;
	}

	.links-buttons {
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
		margin-top: 2rem;
	}

	/* Full-width pills: easy thumb targets, in the nav band's rose with
	   white text (5.1:1, AA). */
	.links-button {
		display: block;
		padding: 0.8rem 1rem;
		border: 2px solid var(--color-nav);
		border-radius: 999px;
		background: var(--color-nav);
		color: var(--color-nav-text);
		font-size: 1.15rem;
		text-align: center;
		text-decoration: none;
	}

	.links-button--quiet {
		background: transparent;
		color: var(--color-link);
	}

	.links-button:hover,
	.links-button:focus-visible {
		text-decoration: underline;
	}
</style>
