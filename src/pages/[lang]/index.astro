---
import Layout from '../../layouts/Layout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import Hero from '../../components/Hero.astro';
import PostCard from '../../components/PostCard.astro';
import { sanityClient } from '../../lib/sanity';
import { LATEST_POSTS_QUERY } from '../../lib/queries';
import {
	LATEST_POSTS_HEADING,
	LOCALES,
	NO_POSTS_MESSAGE,
	SITE_TITLE,
	localizedPaths,
	type Locale,
} from '../../lib/i18n';
import type { PostSummary } from '../../lib/content';

// Divisible by 2 and 3, so the grid ends on a full row at every column
// count it uses.
const LATEST_POSTS_LIMIT = 12;

export function getStaticPaths() {
	return LOCALES.map((lang) => ({
		params: { lang },
		props: { lang },
	}));
}

interface Props {
	lang: Locale;
}

const { lang } = Astro.props;

// Untranslated stubs are filtered out in the query itself — the grid is
// the visitor's language only, and an empty-bodied stub has nothing to put
// on a card.
const posts: PostSummary[] = await sanityClient.fetch(LATEST_POSTS_QUERY, {
	lang,
	limit: LATEST_POSTS_LIMIT,
});

// No `pageTitle`: the homepage *is* the site, so it gets the bare site
// name as its <title> rather than "Something · Bir Misra Daha". No
// `description` either — there's nothing to say about the author yet that
// wouldn't be invented.
---
<Layout lang={lang} wide>
	<SiteHeader lang={lang} switcherLinks={localizedPaths()} slot="nav" />
	<Hero slot="hero" />
	<!-- The header logo already shows the site name visually; the h1 keeps
	     the page's heading outline intact for screen readers. -->
	<h1 class="visually-hidden">{SITE_TITLE}</h1>
	<h2>{LATEST_POSTS_HEADING[lang]}</h2>
	{posts.length > 0 ? (
		<ul class="post-grid">
			{posts.map((post) => (
				<li><PostCard lang={lang} post={post} headingLevel={3} variant="tile" /></li>
			))}
		</ul>
	) : (
		<p class="empty">{NO_POSTS_MESSAGE[lang]}</p>
	)}
</Layout>

<style>
	.visually-hidden {
		position: absolute;
		width: 1px;
		height: 1px;
		margin: -1px;
		overflow: hidden;
		clip-path: inset(50%);
		white-space: nowrap;
	}

	h2 {
		font-size: clamp(1.25rem, 3vw, 1.5rem);
		margin: 0 0 1rem;
		text-align: center;
	}

	.empty {
		text-align: center;
	}

	/* 1 column on a phone, 2 on a tablet, 3 on desktop. Explicit
	   breakpoints rather than auto-fill so the column count always divides
	   LATEST_POSTS_LIMIT evenly. */
	.post-grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: 2rem 1.5rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	@media (min-width: 36rem) {
		.post-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	@media (min-width: 60rem) {
		.post-grid {
			grid-template-columns: repeat(3, minmax(0, 1fr));
		}
	}
</style>
