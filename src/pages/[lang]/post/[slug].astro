---
import Layout from '../../../layouts/Layout.astro';
import SiteHeader from '../../../components/SiteHeader.astro';
import { sanityClient } from '../../../lib/sanity';
import { POST_BY_SLUG_QUERY, POST_SLUGS_QUERY, TRANSLATION_SIBLING_QUERY } from '../../../lib/queries';
import {
	LOCALES,
	NOT_TRANSLATED_MESSAGE,
	UNTRANSLATED_POST_LABEL,
	formatDate,
	type Locale,
} from '../../../lib/i18n';
import { blocksToPlainText, renderPortableText, type PortableTextBlock } from '../../../lib/portableText';
import type { CategoryRef, CoverImage } from '../../../lib/content';

interface PostDoc {
	_id: string;
	title: string;
	slug: string;
	publishedAt: string;
	excerpt: string | null;
	coverImage: CoverImage | null;
	categories: CategoryRef[] | null;
	body: PortableTextBlock[] | null;
	language: Locale;
}

interface TranslationSibling {
	translations: Array<{ language: Locale; post: { slug: string; body: PortableTextBlock[] | null } }>;
}

export async function getStaticPaths() {
	const paths = [];
	for (const lang of LOCALES) {
		const slugs = await sanityClient.fetch(POST_SLUGS_QUERY, { lang });
		for (const { slug } of slugs as Array<{ slug: string }>) {
			paths.push({ params: { lang, slug }, props: { lang } });
		}
	}
	return paths;
}

interface Props {
	lang: Locale;
}

const { lang } = Astro.props;
const { slug } = Astro.params;

const post: PostDoc | null = await sanityClient.fetch(POST_BY_SLUG_QUERY, { slug, lang });

// Untranslated = empty/absent body, not a missing document — every post
// exists in both languages via the auto-created translation stub.
const hasBody = Array.isArray(post?.body) && post.body.length > 0;
const paragraphs = hasBody ? blocksToPlainText(post!.body) : [];
const bodyHtml = hasBody ? renderPortableText(post!.body) : '';
const categories = hasBody ? (post!.categories ?? []) : [];

// Meta description: the author's own excerpt when she wrote one, else the
// opening of the body, else nothing at all (an empty description tag is
// worse than no description tag). Never synthesised from anything but the
// post's own text.
const META_DESCRIPTION_MAX = 160;
const bodyText = paragraphs.join(' ').trim();
const excerpt = post?.excerpt?.trim();
const metaDescription =
	excerpt ||
	(bodyText.length > META_DESCRIPTION_MAX
		? `${bodyText.slice(0, META_DESCRIPTION_MAX - 1).trimEnd()}…`
		: bodyText) ||
	undefined;

// Resolve the sibling's slug in every other locale via translation.metadata
// (never by assuming the same slug string works cross-locale). Fall back to
// this page's own slug for the current locale.
const switcherLinks: Partial<Record<Locale, string>> = { [lang]: `/${lang}/post/${slug}` };
if (post) {
	const sibling: TranslationSibling | null = await sanityClient.fetch(TRANSLATION_SIBLING_QUERY, {
		id: post._id,
	});
	if (sibling) {
		for (const translation of sibling.translations) {
			if (translation.post?.slug) {
				switcherLinks[translation.language] = `/${translation.language}/post/${translation.post.slug}`;
			}
		}
	}
}
---
<Layout
	lang={lang}
	pageTitle={hasBody ? post!.title : slug}
	description={hasBody ? metaDescription : undefined}
	ogType="article"
	ogImage={post?.coverImage?.asset?.url}
>
	<SiteHeader lang={lang} switcherLinks={switcherLinks} slot="nav" />
	{hasBody ? (
		<article class="post">
			<h1>{post!.title}</h1>
			{post!.publishedAt && (
				<p class="post__date">
					<time datetime={post!.publishedAt}>{formatDate(post!.publishedAt, lang)}</time>
				</p>
			)}
			{/* Rich text rendered by lib/portableText.ts (escaped, links vetted). */}
			<div class="post__body" set:html={bodyHtml} />
			{categories.length > 0 && (
				<footer class="post__footer">
					<ul class="post__categories">
						{categories.map((category) => (
							<li>
								<a class="post__chip" href={`/${lang}/category/${category.slug}`}>{category.title}</a>
							</li>
						))}
					</ul>
				</footer>
			)}
		</article>
	) : (
		/*
			Same placeholder whether the document is an untranslated stub or
			missing entirely — the reader gets a localized explanation, never
			a 404. The heading keeps the page from being the only one on the
			site without an h1.
		*/
		<>
			<h1>{UNTRANSLATED_POST_LABEL[lang]}</h1>
			<p>{NOT_TRANSLATED_MESSAGE[lang]}</p>
		</>
	)}
</Layout>

<style>
	/* The post itself stays in the reading face; the rest of the site uses
	   the brand face set on <body> in Layout.astro. */
	.post {
		font-family: var(--font-reading);
		font-variant-caps: normal;
		font-size: 1rem;
		font-weight: 400;
	}

	h1 {
		font-size: clamp(1.75rem, 6vw, 2.5rem);
		line-height: 1.2;
		margin: 0 0 0.25rem;
	}

	.post__date {
		margin: 0 0 1.5rem;
		font-size: 0.875rem;
		color: var(--color-muted);
	}

	.post__body {
		overflow-wrap: break-word;
	}

	/* The body is injected HTML (set:html), which scoped styles can't see,
	   hence :global() for everything inside it. */
	.post__body :global(:is(p, ul, ol, blockquote, figure)) {
		margin: 0 0 1.1em;
	}

	.post__body :global(:is(h2, h3)) {
		line-height: 1.25;
		margin: 1.75em 0 0.5em;
	}

	.post__body :global(h2) {
		font-size: 1.5rem;
	}

	.post__body :global(h3) {
		font-size: 1.2rem;
	}

	.post__body :global(:is(ul, ol)) {
		padding-inline-start: 1.5em;
	}

	.post__body :global(li + li) {
		margin-top: 0.25em;
	}

	/* A soft rose rule, like the nav band, rather than a heavy block. */
	.post__body :global(blockquote) {
		margin-inline: 0;
		padding: 0.25em 0 0.25em 1em;
		border-inline-start: 3px solid var(--color-nav);
		color: var(--color-muted);
		font-style: italic;
	}

	.post__body :global(blockquote p) {
		margin: 0;
	}

	.post__body :global(code) {
		padding: 0.1em 0.3em;
		border-radius: 4px;
		background: var(--color-chip);
		font-size: 0.9em;
	}

	.post__body :global(.post-figure img) {
		display: block;
		width: 100%;
		height: auto;
		border-radius: 4px;
	}

	.post__body :global(.post-figure figcaption) {
		margin-top: 0.5em;
		font-size: 0.875rem;
		color: var(--color-muted);
		text-align: center;
	}

	.post__footer {
		margin-top: 2rem;
		padding-top: 1rem;
		border-top: 1px solid var(--color-rule);
	}

	.post__categories {
		display: flex;
		flex-wrap: wrap;
		gap: 0.375rem 0.5rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.post__chip {
		display: inline-block;
		padding: 0.2rem 0.6rem;
		border: 1px solid var(--color-chip-line);
		border-radius: 999px;
		background: var(--color-chip);
		font-size: 0.8125rem;
		text-decoration: none;
	}

	.post__chip:hover,
	.post__chip:focus-visible {
		text-decoration: underline;
	}
</style>
