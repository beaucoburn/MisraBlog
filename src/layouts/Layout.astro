---
// Shared base layout for all locale-prefixed pages.
//
// Establishes the DOM split the daisy motif needs (see CLAUDE.md "Design:
// Daisy Motif"):
//   - `.bloom-layer` — fixed, full-page, low z-index, purely decorative
//     (`aria-hidden`, `pointer-events: none`) so it never intercepts input
//     or shows up to assistive tech. On hover-capable desktops it hosts the
//     BloomTrail island; touch devices never load that island's JS.
//   - `.content-box[data-bloom-keepout]` — inner content wrappers (nav,
//     main, footer) that sit above the bloom layer with an opaque
//     background. The bloom trail reads `data-bloom-keepout` to compute
//     keep-out rects via `getBoundingClientRect()`. The middle one is a
//     real <main> element (landmark) rather than a div.
//   - On touch devices, a static row of small daisies sits in each gap
//     between boxes instead (pure CSS, `.content-box::before` below).
import { Font } from 'astro:assets';
import BloomTrail from '../components/BloomTrail.svelte';
import SiteFooter from '../components/SiteFooter.astro';
// External sprite URLs rather than inlined SVG: the two sprites share
// symbol ids (daisy-0 … daisy-5), and as cached files they cost nothing
// on pages after the first.
import pinkSprite from '../assets/daisies/pink/daisy-bloom-sprite.svg?url';
import whiteSprite from '../assets/daisies/white/daisy-bloom-sprite.svg?url';
import { SITE_TITLE, type Locale } from '../lib/i18n';

interface Props {
	lang: Locale;
	// Page-specific part of <title> only — the site name is appended here
	// so no page has to remember to do it. Omitted on pages that *are* the
	// site (the homepage), which get the bare site name.
	pageTitle?: string;
	// SEO/social meta. All optional: a page that has nothing truthful to
	// say about itself renders no description rather than an empty tag.
	description?: string;
	ogType?: 'website' | 'article';
	ogImage?: string;
	// Widens <main> from reading width to the full site width, for pages
	// whose main content is a grid (the homepage) rather than prose.
	wide?: boolean;
}

const { lang, pageTitle, description, ogType = 'website', ogImage, wide = false } = Astro.props;

const fullTitle = pageTitle ? `${pageTitle} · ${SITE_TITLE}` : SITE_TITLE;

// Pages without their own image (everything but posts with a cover) share
// the brand link preview. Social sites need an absolute URL, and its size is
// known, so it also gets width/height hints.
// (Astro.site is unset when rendered outside a full build, e.g. in tests.)
const DEFAULT_OG_IMAGE = new URL('/og-image.png', Astro.site ?? Astro.url).href;
const socialImage = ogImage ?? DEFAULT_OG_IMAGE;

// A link preview needs something truthful to say. Pages with a description
// have that; site-level pages (no pageTitle, i.e. the homepage, where Instagram
// link-in-bio traffic lands) do too, since their title is just the site name
// and the image is the brand card. Anything else (e.g. an untranslated post,
// whose title would be a bare slug) gets no og tags rather than misleading ones.
const hasLinkPreview = Boolean(description) || !pageTitle;
---

<html lang={lang}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" href="/favicon.ico" sizes="48x48" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<link rel="manifest" href="/site.webmanifest" />
		<meta name="theme-color" content="#f8e6ee" />
		<meta name="generator" content={Astro.generator} />
		<Font cssVariable="--font-cormorant" preload />
		<title>{fullTitle}</title>
		<link rel="canonical" href={Astro.url} />
		{description && <meta name="description" content={description} />}
		{hasLinkPreview && (
			<>
				<meta property="og:title" content={fullTitle} />
				{description && <meta property="og:description" content={description} />}
				<meta property="og:type" content={ogType} />
				<meta property="og:url" content={Astro.url} />
				<meta property="og:image" content={socialImage} />
				{socialImage === DEFAULT_OG_IMAGE && (
					<>
						<meta property="og:image:width" content="1200" />
						<meta property="og:image:height" content="630" />
					</>
				)}
			</>
		)}
	</head>
	<body>
		<div class="bloom-layer" aria-hidden="true">
			<BloomTrail
				client:media="(hover: hover) and (pointer: fine)"
				sprites={{ pink: pinkSprite, white: whiteSprite }}
			/>
		</div>
		<div class="content-box content-box--wide" data-bloom-keepout>
			<slot name="nav" />
		</div>
		{Astro.slots.has('hero') && (
			<div class="content-box content-box--wide content-box--flush" data-bloom-keepout>
				<slot name="hero" />
			</div>
		)}
		<main class:list={['content-box', { 'content-box--wide': wide }]} data-bloom-keepout>
			<slot />
		</main>
		<div class="content-box content-box--wide content-box--last" data-bloom-keepout>
			<SiteFooter lang={lang} />
		</div>
	</body>
</html>

<style is:global>
	/* Site palette ("Rose garden": pink leads, lilac on category chips).
	   Every color on the site comes from these tokens, so retuning the
	   palette is an edit here only. Text/link/muted/chip-text pairs were
	   checked against WCAG AA (4.5:1) on the box and chip backgrounds:
	   text 15.2:1, link 7.6:1, muted 6.6:1, chip text 6.5:1, nav text on
	   the rose nav bar 5.1:1 — re-check if any of these change. */
	:root {
		--color-nav: #b24a74;
		--color-nav-text: #ffffff;
		--color-page: #f8e6ee;
		--color-box: #fffafc;
		--color-text: #2b2027;
		--color-muted: #6b5562;
		--color-link: #8c2f5a;
		--color-rule: #edd2de;
		--color-chip: #efe5f7;
		--color-chip-line: #d8c6ec;

		/* Shared so children can line up with (or bleed past) a box's edge,
		   e.g. the header's nav bar sitting flush on the box's bottom edge. */
		--content-box-padding: clamp(1rem, 4vw, 2rem);

		/* Space between content boxes (and above the first / below the last).
		   Touch devices widen it so the static daisy row fits (see
		   .content-box::before). */
		--box-gap: 1rem;
		--gap-daisy-size: 20px;

		/* Brand face for everything outside post bodies (set in small caps on
		   <body>; see astro.config.mjs for why it isn't the SC family); the
		   reading face is for long-form text (post pages opt into it on
		   their <article>). */
		--font-brand: var(--font-cormorant);
		--font-reading: system-ui, -apple-system, 'Segoe UI', sans-serif;
	}

	/* The exact complement of the bloom trail's client:media query, so every
	   device gets one daisy treatment or the other, never both or neither. */
	@media not all and (hover: hover) and (pointer: fine) {
		:root {
			--box-gap: 1.5rem;
		}
	}

	*,
	*::before,
	*::after {
		box-sizing: border-box;
	}

	body {
		margin: 0;
		/* Vertical only — the content boxes stay free to run edge to edge on
		   a phone, per the no-fixed-min-width rule for .content-box. */
		padding: var(--box-gap) 0;
		background: var(--color-page);
		color: var(--color-text);
		font-family: var(--font-brand);
		font-variant-caps: small-caps;
		/* Cormorant's small capitals run small and thin next to a system
		   sans, so the brand face gets a larger base size and a medium
		   weight. Post bodies reset all of this (see post/[slug].astro). */
		font-size: 1.125rem;
		font-weight: 500;
		line-height: 1.6;
	}

	/* Nothing may force horizontal scrolling on a narrow screen. */
	img {
		max-width: 100%;
		height: auto;
	}

	a {
		color: var(--color-link);
	}

	/* Reinforce (never remove) the default focus ring. */
	:focus-visible {
		outline: 3px solid var(--color-link);
		outline-offset: 2px;
	}
</style>

<style>
	.bloom-layer {
		position: fixed;
		inset: 0;
		z-index: 0;
		pointer-events: none;
	}

	.content-box {
		position: relative;
		z-index: 1;
		background: var(--color-box);
		/* Fluid padding and a max-width rather than a fixed width: the box
		   goes full-bleed on a phone and becomes an inset card on wider
		   screens, where the surrounding page margin is the area the future
		   bloom trail gets to fill. */
		padding: var(--content-box-padding);
		width: 100%;
		max-width: 48rem;
		margin: 0 auto var(--box-gap);
	}

	/* Site-width boxes (header, hero, footer, and grid pages' <main>). Prose
	   pages keep the narrower reading width above, centered under them. */
	.content-box--wide {
		max-width: 72rem;
	}

	/* For full-bleed media like the hero photo: no inner padding. (No
	   overflow clipping: the hero image already sizes itself to the box, and
	   clipping would hide the gap daisies drawn just outside it.) */
	.content-box--flush {
		padding: 0;
	}

	/* Touch devices: a static row of small daisies in the gap above each box
	   (the first box's sits in the body's top padding), plus one below the
	   last box (the footer's, marked .content-box--last). Pure CSS, no JS. Mostly white with a pink accent, mixing
	   stages 3–5 (mostly full bloom) per the designer's README; two
	   arrangements alternate so neighbouring gaps don't match. */
	@media not all and (hover: hover) and (pointer: fine) {
		.content-box::before,
		.content-box--last::after {
			content: '';
			position: absolute;
			left: 0;
			right: 0;
			height: var(--box-gap);
			pointer-events: none;
			background-repeat: no-repeat;
			background-size: var(--gap-daisy-size);
			background-image:
				url('../assets/daisies/white/daisy-5-full-bloom.svg'),
				url('../assets/daisies/white/daisy-4-open.svg'),
				url('../assets/daisies/pink/daisy-5-full-bloom.svg'),
				url('../assets/daisies/white/daisy-5-full-bloom.svg'),
				url('../assets/daisies/white/daisy-3-half-open.svg'),
				url('../assets/daisies/white/daisy-5-full-bloom.svg');
			background-position:
				7% 50%,
				24% 50%,
				43% 50%,
				61% 50%,
				78% 50%,
				94% 50%;
		}

		.content-box::before {
			bottom: 100%;
		}

		.content-box--last::after {
			top: 100%;
		}

		.content-box:nth-child(even)::before,
		.content-box--last::after {
			background-image:
				url('../assets/daisies/white/daisy-4-open.svg'),
				url('../assets/daisies/white/daisy-5-full-bloom.svg'),
				url('../assets/daisies/white/daisy-5-full-bloom.svg'),
				url('../assets/daisies/pink/daisy-4-open.svg'),
				url('../assets/daisies/white/daisy-5-full-bloom.svg'),
				url('../assets/daisies/pink/daisy-5-full-bloom.svg');
			background-position:
				12% 50%,
				29% 50%,
				50% 50%,
				66% 50%,
				83% 50%,
				97% 50%;
		}
	}
</style>
